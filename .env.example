# URL of vin-check-api INCLUDING the version prefix (leave unset for a disconnected UI preview).
# Public value — never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/v1
# Public URL of this site (robots.txt / sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Payment badges to show — only what is enabled in Stripe:
# visa,mastercard,paypal,applepay,googlepay,sepa,klarna
NEXT_PUBLIC_PAYMENT_METHODS=visa,mastercard
